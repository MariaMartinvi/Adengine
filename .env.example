# Usuario y contraseña para entrar en la app (Basic Auth). Sin ADMIN_PASSWORD la app queda cerrada.
ADMIN_USER=admin
ADMIN_PASSWORD=
# Base de datos Postgres (Vercel Postgres / Neon). Prisma la usa en build y runtime.
DATABASE_URL=
# URL pública de la app, sin barra final. Ej: https://adengine.vercel.app
APP_URL=
# Clave para cifrar los tokens de Google en la base de datos: 32 bytes en hex (openssl rand -hex 32)
ENCRYPTION_KEY=
# Cliente OAuth "AdEngine" del proyecto de Google Cloud con acceso Basic
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# ID del MCC sin guiones (Comartinvi Global)
GOOGLE_LOGIN_CUSTOMER_ID=6253938766
# Opcional desde sep-2026 (ignorado por Google, se envía si existe)
GOOGLE_DEVELOPER_TOKEN=
GOOGLE_ADS_API_VERSION=v22
# Modelo que genera fichas, palabras y anuncios
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6
# Protege /api/cron/sync (Vercel lo envía automáticamente en Authorization: Bearer)
CRON_SECRET=
# Stripe: ventas reales -> conversiones en Google Ads
STRIPE_WEBHOOK_SECRET=
# Opcional: clave secreta de Stripe (solo se usa para verificar la firma del webhook)
STRIPE_SECRET_KEY=
# Meta Ads: token de un usuario del sistema del porfolio (no caduca), con ads_management, ads_read y business_management
META_ACCESS_TOKEN=
