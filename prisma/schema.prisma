generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Conexión OAuth con Google Ads (una por cuenta de Google que autorice)
model GoogleConnection {
  id              String   @id @default(cuid())
  email           String   @unique
  refreshTokenEnc String
  createdAt       DateTime @default(now())
}

// La ficha: única entrada del motor. Todo lo demás se deriva de aquí.
model Business {
  id                 String      @id @default(cuid())
  name               String
  url                String
  sells              String
  audience           String
  country            String      @default("ES")
  language           String      @default("es")
  currency           String      @default("EUR")
  price              Float
  marginPct          Float       @default(70)
  saleEvent          String      @default("Primer pago")
  cacCap             Float
  maxCpc             Float       @default(0.7)
  dailyBudget        Float       @default(10)
  totalCap           Float       @default(300)
  googleCustomerId   String?
  conversionActionId String?
  metaAdAccountId    String?
  metaPixelId        String?
  metaPageId         String?
  metaAdvertiser     String?
  metaInstagramId    String?
  ageMin             Int         @default(18)
  ageMax             Int         @default(65)
  metaCta            String      @default("SHOP_NOW")
  googlePath1        String?
  googlePath2        String?
  metaVisitorsAudienceId String?
  metaBuyersAudienceId   String?
  notes              String?
  createdAt          DateTime    @default(now())
  campaigns          Campaign[]
  actions            ActionLog[]
  sales              Sale[]
  references         Reference[]
  products           Product[]
}

model Campaign {
  id               String        @id @default(cuid())
  businessId       String
  business         Business      @relation(fields: [businessId], references: [id], onDelete: Cascade)
  channel          String        @default("google")
  name             String
  status           String        @default("DRAFT")
  dailyBudget      Float
  totalCap         Float
  googleCampaignId String?
  googleBudgetId   String?
  googleAdGroupId  String?
  metaCampaignId   String?
  metaAdSetId      String?
  metaRtAdSetId    String?
  groups           Json?
  keywords         Keyword[]
  ads              Ad[]
  metrics          DailyMetric[]
  proposals        Proposal[]
  createdAt        DateTime      @default(now())
}

model Keyword {
  id                String        @id @default(cuid())
  campaignId        String
  campaign          Campaign      @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  text              String
  matchType         String        @default("PHRASE")
  maxCpc            Float
  estCpcLow         Float?
  estCpcHigh        Float?
  volume            Int?
  intent            String?
  included          Boolean       @default(true)
  status            String        @default("ENABLED")
  googleCriterionId String?
  finalUrl          String?
  adGroup           String?
  googleAdGroupId   String?
  metrics           DailyMetric[]
}

model Ad {
  id           String   @id @default(cuid())
  campaignId   String
  campaign     Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  headlines    Json
  descriptions Json
  finalUrl     String
  googleAdId   String?
  metaAdId     String?
  metaRtAdId   String?
  mediaType    String?
  mediaUrl     String?
  mediaRef     String?
  basedOn      String?
  brief        String?
  thumbRef     String?
  adGroup      String?
  path1        String?
  path2        String?
  included     Boolean  @default(true)
  refId        String?
  status       String   @default("ENABLED")
}

model DailyMetric {
  id          String   @id @default(cuid())
  campaignId  String
  campaign    Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  keywordId   String?
  keyword     Keyword? @relation(fields: [keywordId], references: [id], onDelete: Cascade)
  adId        String?
  date        DateTime @db.Date
  impressions Int      @default(0)
  clicks      Int      @default(0)
  cost        Float    @default(0)
  conversions Float    @default(0)
  convValue   Float    @default(0)
  @@unique([campaignId, keywordId, date])
}

// Cambios que la herramienta propone y que tú apruebas o descartas
model Proposal {
  id         String   @id @default(cuid())
  campaignId String
  campaign   Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  kind       String
  target     String
  payload    Json
  reason     String
  status     String   @default("PENDING")
  createdAt  DateTime @default(now())
}

// Todo lo que pasa, con motivo. auto = lo hizo la herramienta sola.
model ActionLog {
  id         String   @id @default(cuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  kind       String
  detail     String
  auto       Boolean  @default(false)
  createdAt  DateTime @default(now())
}

model Visitor {
  id        String   @id @default(cuid())
  email     String?
  gclid     String?
  fbclid    String?
  ttclid    String?
  landing   String?
  createdAt DateTime @default(now())
  @@index([email])
}

model Sale {
  id         String   @id @default(cuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  email      String
  amount     Float
  currency   String
  gclid      String?
  channel    String?
  uploaded   Boolean  @default(false)
  createdAt  DateTime @default(now())
}

// Anuncios que funcionan (de la competencia o propios), por canal. La IA replica su estructura al escribir.
model Reference {
  id         String   @id @default(cuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  channel    String
  note       String
  image      String?
  video      Boolean  @default(false)
  audio      String?
  product    String?
  productId  String?
  item       Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  createdAt  DateTime @default(now())
}

// Nuestros productos (p. ej. cada cuadro): con ellos se hacen los anuncios que copian las referencias.
model Product {
  id         String      @id @default(cuid())
  businessId String
  business   Business    @relation(fields: [businessId], references: [id], onDelete: Cascade)
  name       String
  url        String
  image      String?
  references Reference[]
  createdAt  DateTime    @default(now())
}
